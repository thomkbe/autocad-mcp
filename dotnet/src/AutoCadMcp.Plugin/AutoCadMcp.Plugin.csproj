<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- AutoCAD's assemblies are built against both desktop frameworks; we use WPF's Dispatcher. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- AutoCAD 2025 and 2026 run on .NET 8 (2027 moved to .NET 10). Override with -p:AcadDir=... -->
    <AcadDir Condition="'$(AcadDir)' == ''">C:\Program Files\Autodesk\AutoCAD 2026</AcadDir>
  </PropertyGroup>

  <!-- Only the core AutoCAD assemblies, so the plugin also loads in accoreconsole.
       Private=false: AutoCAD supplies them at runtime. -->
  <ItemGroup>
    <Reference Include="accoremgd">
      <HintPath>$(AcadDir)\accoremgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="acdbmgd">
      <HintPath>$(AcadDir)\acdbmgd.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Avoid clashes such as System.Drawing.Color vs Autodesk.AutoCAD.Colors.Color. -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\shared\PipeProtocol.cs" Link="Shared\PipeProtocol.cs" />
  </ItemGroup>

</Project>
